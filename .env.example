# =============================================================================
# Campanhas SHILD — variaveis de ambiente
# Local: copie para .env.  Coolify: cole em Environment Variables.
# Marcadas com (*) sao OBRIGATORIAS.
# =============================================================================

# ---- Banco (*) --------------------------------------------------------------
# No Coolify: crie um Postgres e cole aqui a Internal URL dele.
# postgres:// e postgresql:// sao aceitos e convertidos sozinhos.
# Vazio = usa um SQLite local (so para desenvolvimento na sua maquina).
DATABASE_URL=

# ---- Planilha Google (*) ----------------------------------------------------
# Aceita a URL inteira ou so o ID.
SHEET_ID=https://docs.google.com/spreadsheets/d/1QLj8NlZOK50lcC5NhZ76mOz9DN7JWhjR_Wq0u8ZTsWc/
# Nome da aba. Vazio = a primeira aba da planilha.
SHEET_TAB=
# Linha onde esta o cabecalho (a planilha da SHILD comeca na 5).
SHEET_HEADER_ROW=5
# (*) A credencial. Escolha UMA das tres formas abaixo.
#
# Forma A (recomendada no Coolify) — duas variaveis, tiradas do JSON baixado:
#   GOOGLE_SA_EMAIL      = o campo "client_email"
#   GOOGLE_SA_PRIVATE_KEY= o campo "private_key" (pode colar com \n literal, numa linha)
GOOGLE_SA_EMAIL=
GOOGLE_SA_PRIVATE_KEY=
#
# Forma B — o JSON inteiro, numa linha so:
GOOGLE_CREDENTIALS_JSON=
#
# Forma C (pratica no seu PC) — caminho do arquivo baixado:
GOOGLE_CREDENTIALS_FILE=
#
# NAO existe forma com client_id + client_secret: numa conta de servico quem assina
# e a chave privada. client_id/secret sao de OAuth, que exige alguem clicar em
# "Permitir" no navegador — nao ha ninguem para fazer isso num servidor.
#
# Onde pegar: Google Cloud > IAM > Contas de servico > Criar > Chaves > JSON.
# Depois compartilhe a planilha com esse email como EDITOR.

# ---- Servidor ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8010
# So cache descartavel (imagens montadas). No container ja vem /tmp/campanhas.
OUTPUT_DIR=saidas

# ---- Email: Brevo -----------------------------------------------------------
# API KEY (xkeysib-). Necessaria para ler aberturas e cliques.
BREVO_API_KEY=
# Relay SMTP: e o que faz o poster aparecer DENTRO do email (a API v3 nao embute).
# Brevo > SMTP & API > aba SMTP. A chave comeca com xsmtpsib-.
BREVO_SMTP_HOST=smtp-relay.brevo.com
BREVO_SMTP_PORT=587
BREVO_SMTP_LOGIN=
BREVO_SMTP_KEY=
# auto = SMTP se estiver configurado, senao API. Force com "smtp" ou "api".
TRANSPORTE=auto

# Remetente. O dominio precisa estar autenticado no Brevo (SPF/DKIM).
MAIL_FROM_DOMAIN=shild.click
MAIL_FROM_PREFIX=comunicados
MAIL_FROM_NAME=Comunicados {empresa}
# 1 = endereco unico por empresa (comunicados-nome-da-empresa@dominio)
MAIL_FROM_PER_EMPRESA=0
MAIL_REPLY_TO=
MAIL_UNSUBSCRIBE_EMAIL=
MAIL_TEST_TO=

# Tag da campanha: troque a cada campanha nova para os numeros nao se misturarem.
CAMPAIGN_TAG=campanha-interna
SEND_DELAY_SECONDS=1.5

# ---- WhatsApp: Evolution API ------------------------------------------------
EVOLUTION_API_URL=
# Token da INSTANCIA, nao o token global do servidor.
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE=
# NAO abaixe muito: disparo rapido em massa e o caminho mais curto para
# o numero ser bloqueado pelo WhatsApp.
WA_DELAY_SECONDS=8
# DDD usado quando a planilha traz o numero sem DDD. Vazio = recusa esses numeros.
WA_DDD_PADRAO=

# ---- Marca SHILD ------------------------------------------------------------
# Desnecessario com o SMTP ligado (a logo vai embutida no email).
EMAIL_LOGO_URL=
SHILD_SITE_URL=https://shild.click/
INSTAGRAM_URL=https://www.instagram.com/shildconsultoria/
